# ECHO-ASSIST AI Backend Configuration
# Copy this file to .env and fill in real values. Never commit .env.

# App
APP_NAME=ECHO-ASSIST AI
ENVIRONMENT=development
DEBUG=true

# Security
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Database
# PostgreSQL is required for normal application runtime. SQLite is supported
# only for isolated automated tests.
DATABASE_URL=postgresql+psycopg://echo_assist:change-me@localhost:5432/echo_assist
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Docker Compose database variables (the backend uses host `db` inside Compose)
POSTGRES_DB=echo_assist
POSTGRES_USER=echo_assist
POSTGRES_PASSWORD=change-me

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Maps / Navigation (required to request walking routes; no invented fallback)
MAPS_API_KEY=

# AI Engine
AI_DEVICE=auto
AI_CONFIDENCE_THRESHOLD=0.5
AI_MOCK_MODE=true

# Messaging/email providers (development mocks report no delivery if empty)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
FRONTEND_BASE_URL=http://localhost:8000
PUSH_NOTIFICATION_KEY=

#
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
