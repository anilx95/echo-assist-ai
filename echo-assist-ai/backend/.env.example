# ECHO-ASSIST AI Backend Configuration
# Copy this file to .env and fill in real values. Never commit .env.

# App
APP_NAME=ECHO-ASSIST AI
ENVIRONMENT=development
DEBUG=true

# Security
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# SQLite for MVP. Swap to a Postgres URL for production, e.g.:
# postgresql://user:password@localhost:5432/echo_assist
DATABASE_URL=sqlite:///./echo_assist.db

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Maps / Navigation (optional - mock navigation used if empty)
MAPS_API_KEY=

# AI Engine
AI_DEVICE=auto
AI_CONFIDENCE_THRESHOLD=0.5
AI_MOCK_MODE=true

# Emergency notification providers (mock services used if empty)
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
PUSH_NOTIFICATION_KEY=

#
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
